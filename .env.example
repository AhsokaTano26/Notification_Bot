# NoneBot 驱动。QQ 需要 HTTP 客户端驱动来获取 access token。

DRIVER=~fastapi+~httpx

# QQ 官方机器人凭据。直接从 QQ 开放平台复制对应的值即可，
# 这里不需要填写 JSON。
QQ_APP_ID=your-app-id
QQ_TOKEN=your-app-token
QQ_SECRET=your-app-secret

# 通过公网 HTTPS 回调接收 QQ 事件，而不是使用 WebSocket。

QQ_USE_WEBSOCKET=false
QQ_VERIFY_WEBHOOK=true

# 保持为 true，以接收 QQ 群聊中的命令事件。

QQ_C2C_GROUP_AT_MESSAGES=true

# 在目标群中使用 /群信息 命令，以获取目标群 OpenID。
# /uptime-kuma
TARGET_GROUP_OPENID=replace-with-group-openid
# /uptime-kuma/lanunion
TARGET_GROUP_LANUNION_OPENID=replace-with-lanunion-group-openid

# Alertmanager 专用目标群。
# 如果有多个 OpenID，请使用英文逗号分隔。
# /alert/lanunion
ALERTMANAGER_LANUNION_GROUP_OPENIDS=replace-with-lanunion-group-openid
# /alert/tano
ALERTMANAGER_TANO_GROUP_OPENIDS=replace-with-tano-group-openid
