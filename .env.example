# NoneBot drivers. QQ needs the HTTP client driver to obtain access tokens.
DRIVER=~fastapi+~httpx

# QQ Official Bot credentials. Copy the values directly from the QQ Developer
# Platform; no JSON needs to be written here.
QQ_APP_ID=your-app-id
QQ_TOKEN=your-app-token
QQ_SECRET=your-app-secret

# Receive QQ events through the public HTTPS callback instead of WebSocket.
QQ_USE_WEBSOCKET=false
QQ_VERIFY_WEBHOOK=true

# Keep this true to receive QQ group command events.
QQ_C2C_GROUP_AT_MESSAGES=true

# Use /群信息 in the target group to obtain TARGET_GROUP_OPENID.
TARGET_GROUP_OPENID=replace-with-group-openid

# Dedicated target groups for Alertmanager. Separate multiple OpenIDs with commas.
# /alert/lanunion
ALERTMANAGER_LANUNION_GROUP_OPENIDS=replace-with-lanunion-group-openid
# /alert/tano
ALERTMANAGER_TANO_GROUP_OPENIDS=replace-with-tano-group-openid
